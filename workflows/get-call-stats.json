      "name": "Get row(s)"
    },
    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\n\nconst rows = $input.all();\n\nlet filtered = rows;\n\nif (input.startDate && input.endDate) {\n  const startDate = new Date(input.startDate);\n  const endDate = new Date(input.endDate);\n  endDate.setHours(23, 59, 59, 999);\n\n  filtered = rows.filter(item => {\n    const created = new Date(item.json.createdAt);\n    return created >= startDate && created <= endDate;\n  });\n}\n\nconst totalCalls = filtered.length;\n\nconst negativeCalls = filtered.filter(\n  item => item.json.tone === \"negative\"\n).length;\n\nconst negativeCallPercent =\n  totalCalls === 0\n    ? 0\n    : Math.round((negativeCalls / totalCalls) * 100);\n\nreturn [{\n  json: {\n    totalCalls,\n    negativeCalls,\n    negativeCallPercent\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
